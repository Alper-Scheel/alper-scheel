<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>de</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>ALVA-TEXT</string>
    <key>CFBundleDisplayName</key>
    <string>ALVA-TEXT</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>2.1.6</string>
    <key>CFBundleVersion</key>
    <string>28</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 AdLuna GmbH. Alle Rechte vorbehalten.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>ALVA-TEXT nimmt dein Diktat auf, während du einen Hotkey gedrückt hältst, und wandelt es per Whisper-API in Text um. Kein Dauermithören, nur während aktiver Aufnahme.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>ALVA-TEXT fügt den transkribierten Text automatisch in die fokussierte App ein — dafür simuliert es einen ⌘V-Tastendruck. Diese Berechtigung ist nur für das automatische Einfügen nötig.</string>
    <key>NSAppleEventsUsageDescription</key>
    <string>ALVA-TEXT aktiviert die zuvor fokussierte App kurz bevor es den transkribierten Text einfügt, damit ⌘V am richtigen Ort ankommt.</string>
</dict>
</plist>
