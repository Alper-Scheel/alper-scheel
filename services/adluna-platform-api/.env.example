# AdLuna Platform API — Environment Template
# Kopiere diese Datei nach `.env` und trage echte Werte ein.
# Die echte `.env` ist via .gitignore vom Commit ausgeschlossen.

# --- Resend (Transaktionale E-Mails) ---
# API-Key aus Resend-Dashboard: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=no-reply@mail.adluna.de
RESEND_FROM_NAME=AdLuna Platform

# --- License-Server ---
LICENSE_SERVER_ENV=production
LICENSE_SERVER_PORT=8080
LICENSE_SERVER_BIND_HOST=127.0.0.1
LICENSE_SERVER_DB_PATH=./data/license.db

# --- Admin-Token (kryptographisch zufällig generieren beim Deployment) ---
# Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADLUNA_ADMIN_TOKEN=CHANGE_ME_ON_DEPLOYMENT

# --- Server-Config-Defaults (überschreibbar via DB-Tabelle server_config) ---
BETA_MODE_GLOBAL=true
DEFAULT_TRIAL_DAYS=14
ACTIVATION_CODE_TTL_MINUTES=15
LICENSE_CHECK_TTL_SECONDS=86400
